# Local development defaults. Copy this file to .env before starting services.
POSTGRES_USER=markethub_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=markethub_db
POSTGRES_PORT=5434

# The backend and migrations run on the host.
DATABASE_URL=postgresql+asyncpg://markethub_user:replace_with_a_local_password@localhost:5434/markethub_db
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEFAULT_LANGUAGE=ru
